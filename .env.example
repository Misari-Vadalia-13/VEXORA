# ==============================================================================
# VEXORA Environment Configuration Example
# Copy this file to .env to configure application flags and secrets:
#   copy .env.example .env
# ==============================================================================

# --- Database Configuration ---
# Absolute or relative path to the SQLite database file (defaults to backend/vexora.db)
VEXORA_DB_PATH=backend/vexora.db

# --- Flask Security ---
# Secret key used for session signing and cryptographic cookies
SECRET_KEY=vexora-forensics-dev-secret-key-2026

# Allowed origins for Cross-Origin Resource Sharing (comma-separated URLs)
VEXORA_CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000,http://127.0.0.1:5500,http://localhost:3000

# --- V2 Forensic Capabilities & Feature Flags ---
# Enable bounding-box evidence overlays in document viewing & report exports
ENABLE_EVIDENCE_OVERLAY=true

# Enable deep PDF structure forensic rules (PDF-001 through PDF-005)
ENABLE_EXTENDED_FORENSICS=true

# Enable pixel-level image forensics (IMG-001 ELA, IMG-002 Sharpness, IMG-003 Copy-Move, IMG-004 Signature)
ENABLE_IMAGE_FORENSICS=true

# Enable multi-document relationship correlation and transaction graph generation
ENABLE_CORRELATOR=true

# Strict OCR Mode: if true, requires native Tesseract OCR and fails if binary is missing.
# If false (default), degrades safely to fallback mode with visible badge when Tesseract is absent.
VEXORA_STRICT_OCR=false

# --- AI & LLM Reasoning Layer (Phase 2) ---
# Set to true to activate LLM-powered finding explanations, field extraction, and contextual cross-checking.
# When false (default), the app operates 100% reliably in deterministic rules engine mode.
ENABLE_LLM=false

# LLM Provider: 'gemini' (preferred, free tier) or 'openai'
VEXORA_LLM_PROVIDER=gemini

# Model identifier for the selected provider:
# - Google Gemini (recommended): gemini-2.5-flash
# - OpenAI: gpt-4o-mini
VEXORA_LLM_MODEL=gemini-2.5-flash

# API key for the LLM provider (leave blank when ENABLE_LLM=false):
# - Google Gemini: obtain free API key at https://aistudio.google.com/app/apikey
# - OpenAI: obtain API key at https://platform.openai.com/api-keys
VEXORA_LLM_API_KEY=

# Redact detected PII entities (SSNs, tax IDs, emails, phones, account numbers) before transmitting text to LLM
VEXORA_LLM_REDACT=true
